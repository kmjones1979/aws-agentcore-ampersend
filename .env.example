# ==============================================
# AgentCore Wallet (Coinbase CDP) — Production
# ==============================================

# Coinbase Developer Platform credentials
# Get these from https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ==============================================
# Fallback: Raw Private Key — Testing Only
# ==============================================

# Used when CDP credentials are not set
BUYER_PRIVATE_KEY=0x...

# ==============================================
# Ampersend Smart Account (optional, for AmpersendTreasurer)
# ==============================================

BUYER_SMART_ACCOUNT_ADDRESS=0x...
BUYER_SESSION_KEY_PRIVATE_KEY=0x...
AMPERSEND_API_URL=https://api.ampersend.ai

# ==============================================
# Seller
# ==============================================

# Receives USDC from buyers (usually Base Sepolia when CHAIN_NETWORK=base-sepolia)
SELLER_WALLET_ADDRESS=0x...

# Signs x402 to BlockRun — fund this address on Base mainnet (may differ from SELLER_WALLET_ADDRESS)
SELLER_PRIVATE_KEY=0x...

# ==============================================
# ClawRouter (LLM Service)
# ==============================================

# Direct API: use a concrete model id (e.g. claude-haiku-4.5). Routing profiles like blockrun/auto are for the local ClawRouter proxy only.
CLAWROUTER_MODEL=claude-haiku-4.5

# ==============================================
# Network
# ==============================================

# base-sepolia for testnet, base for mainnet
CHAIN_NETWORK=base-sepolia

# ==============================================
# Ports
# ==============================================

SELLER_PORT=8000
PROXY_PORT=8402
