# ==============================================
# Ampersend / Wallet (Buyer)
# ==============================================

# EOA private key — used by NaiveTreasurer (testing only)
BUYER_PRIVATE_KEY=0x...

# Smart account credentials — used by AmpersendTreasurer (production)
BUYER_SMART_ACCOUNT_ADDRESS=0x...
BUYER_SESSION_KEY_PRIVATE_KEY=0x...

# ==============================================
# Seller
# ==============================================

# Wallet address that receives payments
SELLER_WALLET_ADDRESS=0x...

# ==============================================
# AWS (Bedrock + AgentCore)
# ==============================================

AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ==============================================
# Network
# ==============================================

# base-sepolia for testnet, base for mainnet
CHAIN_NETWORK=base-sepolia

# ==============================================
# Ampersend API (optional, for AmpersendTreasurer)
# ==============================================

AMPERSEND_API_URL=https://api.ampersend.ai

# ==============================================
# Seller Server
# ==============================================

SELLER_PORT=8000
